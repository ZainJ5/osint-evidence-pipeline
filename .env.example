# Copy to .env for local development. Local docker-compose defaults only; never put real secrets here.
DATABASE_URL=postgresql://osint:osint@localhost:5432/osint
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=snapshots
MINIO_SECURE=false
# Optional: raises the GitHub API rate limit. Leave empty for unauthenticated access.
GITHUB_TOKEN=
